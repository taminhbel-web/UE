local function safeCallback(f, ...)
    if not f then return end
    if not Library.NotifyOnError then return f(...) end
    local ok, err = pcall(f, ...)
    if not ok then
        local _, i = err:find(":%d+: ")
        if not i then return Library:Notify(err) end
        return Library:Notify(err:sub(i+1), 3)
    end
end

local function Create(class, props)
    local i = type(class) == "string" and Instance.new(class) or class
    for k, v in next, props or {} do i[k] = v end
    return i
end

local function ApplyTextStroke(i)
    i.TextStrokeTransparency = 1
    Create("UIStroke", {
        Color = Color3.new(0, 0, 0),
        Thickness = 1,
        LineJoinMode = Enum.LineJoinMode.Miter,
        Parent = i,
    })
end

local function CreateLabel(props, isHud)
    local l = Create("TextLabel", {
        BackgroundTransparency = 1,
        Font = Library.Font,
        Text = "",
        TextColor3 = Library.FontColor,
        TextSize = 14,
        TextStrokeTransparency = 0,
    })
    ApplyTextStroke(l)
    Library:AddToRegistry(l, { TextColor3 = "FontColor" }, isHud)
    return Create(l, props)
end

local function AddToolTip(infoStr, hover)
    local X, Y = Library:GetTextBounds(infoStr, Library.Font, 14)
    local tip = Create("Frame", {
        BackgroundColor3 = Library.MainColor,
        BorderColor3 = Library.OutlineColor,
        Size = UDim2.fromOffset(X + 5, Y + 4),
        ZIndex = 100,
        Parent = Library.ScreenGui,
        Visible = false,
    })
    local lbl = CreateLabel({
        Position = UDim2.fromOffset(3, 1),
        Size = UDim2.fromOffset(X, Y),
        TextSize = 14,
        Text = infoStr,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = tip.ZIndex + 1,
        Parent = tip,
    })
    Library:AddToRegistry(tip, { BackgroundColor3 = "MainColor", BorderColor3 = "OutlineColor" })
    Library:AddToRegistry(lbl, { TextColor3 = "FontColor" })
    local hovering = false
    hover.MouseEnter:Connect(function()
        if Library:MouseIsOverOpenedFrame() then return end
        hovering = true
        tip.Position = UDim2.fromOffset(Mouse.X + 15, Mouse.Y + 12)
        tip.Visible = true
        while hovering do
            RunService.RenderStepped:Wait()
            tip.Position = UDim2.fromOffset(Mouse.X + 15, Mouse.Y + 12)
        end
    end)
    hover.MouseLeave:Connect(function()
        hovering = false
        tip.Visible = false
    end)
end

local function OnHighlight(highlight, instance, props, propsDefault)
    local active = {}
    highlight.MouseEnter:Connect(function()
        local reg = Library.RegistryMap[instance]
        for prop, idx in next, props do
            local tv = Library[idx] or idx
            if typeof(tv) == "Color3" then
                if active[prop] then active[prop]:Cancel() end
                local t = TweenService:Create(instance, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { [prop] = tv })
                active[prop] = t
                t:Play()
            else
                instance[prop] = tv
            end
            if reg and reg.Properties[prop] then reg.Properties[prop] = idx end
        end
    end)
    highlight.MouseLeave:Connect(function()
        local reg = Library.RegistryMap[instance]
        for prop, idx in next, propsDefault do
            local tv = Library[idx] or idx
            if typeof(tv) == "Color3" then
                if active[prop] then active[prop]:Cancel() end
                local t = TweenService:Create(instance, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { [prop] = tv })
                active[prop] = t
                t:Play()
            else
                instance[prop] = tv
            end
            if reg and reg.Properties[prop] then reg.Properties[prop] = idx end
        end
    end)
end

function Library:AddToRegistry(instance, props, isHud)
    local idx = #Library.Registry + 1
    local data = { Instance = instance, Properties = props, Idx = idx }
    table.insert(Library.Registry, data)
    Library.RegistryMap[instance] = data
    if isHud then table.insert(Library.HudRegistry, data) end
end

function Library:RemoveFromRegistry(instance)
    local data = Library.RegistryMap[instance]
    if not data then return end
    for i = #Library.Registry, 1, -1 do
        if Library.Registry[i] == data then table.remove(Library.Registry, i) end
    end
    for i = #Library.HudRegistry, 1, -1 do
        if Library.HudRegistry[i] == data then table.remove(Library.HudRegistry, i) end
    end
    Library.RegistryMap[instance] = nil
end

function Library:UpdateColorsUsingRegistry()
    for _, o in next, Library.Registry do
        if o.Instance and o.Instance.Parent then
            for prop, idx in next, o.Properties do
                if type(idx) == "string" then
                    o.Instance[prop] = Library[idx]
                elseif type(idx) == "function" then
                    o.Instance[prop] = idx()
                end
            end
        end
    end
end

function Library:GetTextBounds(text, font, size, res)
    local function strip(s)
        s = s:gsub("<br%s*/>", "\n")
        return (s:gsub("<[^<>]->", ""))
    end
    local b = TextService:GetTextSize(strip(text), size, font, res or Vector2.new(1920, 1080))
    return b.X, b.Y
end

function Library:MapValue(v, minA, maxA, minB, maxB)
    return (1 - ((v - minA) / (maxA - minA))) * minB + ((v - minA) / (maxA - minA)) * maxB
end

function Library:MouseIsOverOpenedFrame()
    for f, _ in next, Library.OpenedFrames do
        local ap, as = f.AbsolutePosition, f.AbsoluteSize
        if Mouse.X >= ap.X and Mouse.X <= ap.X + as.X and Mouse.Y >= ap.Y and Mouse.Y <= ap.Y + as.Y then
            return true
        end
    end
end

function Library:IsMouseOverFrame(f)
    local ap, as = f.AbsolutePosition, f.AbsoluteSize
    return Mouse.X >= ap.X and Mouse.X <= ap.X + as.X and Mouse.Y >= ap.Y and Mouse.Y <= ap.Y + as.Y
end

function Library:UpdateDependencyBoxes()
    for _, db in next, Library.DependencyBoxes do
        db:Update()
    end
end

function Library:SafeCallback(f, ...) return safeCallback(f, ...) end
function Library:GiveSignal(s) table.insert(Library.Signals, s) end

function Library:Unload()
    for i = #Library.Signals, 1, -1 do
        local c = table.remove(Library.Signals, i)
        pcall(function() c:Disconnect() end)
    end
    if Library.OnUnload then Library.OnUnload() end
    Library.ScreenGui:Destroy()
    Library.Unloaded = true
end

function Library:OnUnload(f)
    Library.OnUnload = f
end

function Library:AttemptSave()
    if Library.SaveManager then Library.SaveManager:Save() end
end

