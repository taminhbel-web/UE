    local rb = mkbox("R"); local gb2 = mkbox("G"); local bb = mkbox("B"); local hb = mkbox("HEX", 66)

    local copyBtn = Create("TextButton", {
        BackgroundColor3 = Library.MainColor, BorderColor3 = Library.OutlineColor, BorderMode = Enum.BorderMode.Inset,
        Position = UDim2.new(0, 4, 0, 199), Size = UDim2.new(1, -8, 0, 18),
        Text = "Copy HEX", TextColor3 = Library.FontColor, TextSize = 13, AutoButtonColor = false,
        ZIndex = 18, Parent = frameInner,
    })
    Library:AddToRegistry(copyBtn, { BackgroundColor3 = "MainColor", BorderColor3 = "OutlineColor", TextColor3 = "FontColor" })

    local function updateDisplay()
        picker.Value = Color3.fromHSV(picker.Hue, picker.Sat, picker.Vib)
        svMap.BackgroundColor3 = Color3.fromHSV(picker.Hue, 1, 1)
        display.BackgroundColor3 = picker.Value
        cursor.Position = UDim2.new(picker.Sat, 0, 1 - picker.Vib, 0)
        hueCursor.Position = UDim2.new(picker.Hue, 0, 0, 0)
        rb.Text = tostring(math.floor(picker.Value.R * 255))
        gb2.Text = tostring(math.floor(picker.Value.G * 255))
        bb.Text = tostring(math.floor(picker.Value.B * 255))
        hb.Text = picker.Value:ToHex()
        Library:SafeCallback(picker.Callback, picker.Value)
        Library:SafeCallback(picker.Changed, picker.Value)
    end

    picker.Display = updateDisplay

    local function rgbFocus()
        local r = tonumber(rb.Text) or 255
        local g = tonumber(gb2.Text) or 255
        local b = tonumber(bb.Text) or 255
        picker.Hue, picker.Sat, picker.Vib = Color3.toHSV(Color3.fromRGB(r, g, b))
        updateDisplay()
    end
    rb.FocusLost:Connect(rgbFocus)
    gb2.FocusLost:Connect(rgbFocus)
    bb.FocusLost:Connect(rgbFocus)
    hb.FocusLost:Connect(function()
        local ok, res = pcall(Color3.fromHex, hb.Text)
        if ok and typeof(res) == "Color3" then
            picker.Hue, picker.Sat, picker.Vib = Color3.toHSV(res)
        end
        updateDisplay()
    end)

    copyBtn.MouseButton1Click:Connect(function()
        pcall(setclipboard, picker.Value:ToHex())
        Library:Notify("Copied HEX", 2)
    end)

    svMap.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
                local minX = svMap.AbsolutePosition.X
                local maxX = minX + svMap.AbsoluteSize.X
                local minY = svMap.AbsolutePosition.Y
                local maxY = minY + svMap.AbsoluteSize.Y
                local mx = math.clamp(Mouse.X, minX, maxX)
                local my = math.clamp(Mouse.Y, minY, maxY)
                picker.Sat = (mx - minX) / (maxX - minX)
                picker.Vib = 1 - ((my - minY) / (maxY - minY))
                updateDisplay()
                RunService.RenderStepped:Wait()
            end
        end
    end)

    hueInner.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
                local minX = hueInner.AbsolutePosition.X
                local maxX = minX + hueInner.AbsoluteSize.X
                local mx = math.clamp(Mouse.X, minX, maxX)
                picker.Hue = (mx - minX) / (maxX - minX)
                updateDisplay()
                RunService.RenderStepped:Wait()
            end
        end
    end)

    function picker:SetValueRGB(c, transparency)
        picker.Transparency = transparency or 0
        picker:SetHSVFromRGB(c)
        updateDisplay()
    end
    function picker:SetValue(hsv, transparency)
        local c = Color3.fromHSV(hsv[1], hsv[2], hsv[3])
        picker.Transparency = transparency or 0
        picker:SetHSVFromRGB(c)
        updateDisplay()
    end
    function picker:OnChanged(f) picker.Changed = f; f(picker.Value) end
    function picker:Show()
        for f, _ in next, Library.OpenedFrames do
            if f.Name == "Color" then f.Visible = false; Library.OpenedFrames[f] = nil end
        end
        frameOuter.Position = UDim2.fromOffset(display.AbsolutePosition.X, display.AbsolutePosition.Y + 18)
        frameOuter.Visible = true
        Library.OpenedFrames[frameOuter] = true
    end
    function picker:Hide()
        frameOuter.Visible = false
        Library.OpenedFrames[frameOuter] = nil
    end

    display.InputBegan:Connect(function(input)
        if Library:MouseIsOverOpenedFrame() then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if frameOuter.Visible then picker:Hide() else picker:Show() end
        end
    end)

    Library:GiveSignal(UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local ap, as = frameOuter.AbsolutePosition, frameOuter.AbsoluteSize
            if Mouse.X < ap.X or Mouse.X > ap.X + as.X or Mouse.Y < ap.Y - 21 or Mouse.Y > ap.Y + as.Y then
                picker:Hide()
            end
        end
    end))

    updateDisplay()
    Library.Options[idx] = picker
    return self
end

function BaseAddons:AddSlider(idx, info)
    assert(info.Default and info.Text and info.Min and info.Max and info.Rounding, "AddSlider: missing field")
    local slider = {
        Value = info.Default,
        Min = info.Min,
        Max = info.Max,
        Rounding = math.clamp(info.Rounding, 0, 3),
        Type = "Slider",
        Callback = info.Callback or function() end,
    }

    if not info.Compact then
        CreateLabel({
            Size = UDim2.new(1, 0, 0, 10),
            TextSize = 14,
            Text = info.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Bottom,
            ZIndex = Z(self, 5),
            Parent = self.Container,
        })
        self:AddBlank(3)
    end

    local sc = Create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -4, 0, 13),
        ZIndex = Z(self, 5),
        Parent = self.Container,
    })

    local outer = Create("Frame", {
        BackgroundColor3 = Color3.new(0, 0, 0),
        BorderColor3 = Color3.new(0, 0, 0),
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = Z(self, 5),
        Parent = sc,
    })
    Library:AddToRegistry(outer, { BorderColor3 = "Black" })
    local inner = Create("Frame", {
        BackgroundColor3 = Library.MainColor,
        BorderColor3 = Library.OutlineColor,
        BorderMode = Enum.BorderMode.Inset,
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = Z(self, 6),
        Parent = outer,
    })
    Library:AddToRegistry(inner, { BackgroundColor3 = "MainColor", BorderColor3 = "OutlineColor" })

    local fill = Create("Frame", {
        BackgroundColor3 = Library.AccentColor,
        BorderColor3 = Library.AccentColor,
        Size = UDim2.new(0, 0, 1, 0),
        ZIndex = Z(self, 7),
        Parent = inner,
    })
    Library:AddToRegistry(fill, { BackgroundColor3 = "AccentColor", BorderColor3 = "AccentColor" })

    local disp = CreateLabel({
        Size = UDim2.new(1, 0, 1, 0),
        TextSize = 14,
        Text = "Infinite",
        ZIndex = Z(self, 9),
        Parent = inner,
    })

    OnHighlight(outer, outer, { BorderColor3 = "AccentColor" }, { BorderColor3 = "Black" })
    if type(info.Tooltip) == "string" then AddToolTip(info.Tooltip, outer) end

    function slider:Display()
        local suffix = info.Suffix or ""
        if info.Compact then
            disp.Text = info.Text .. ": " .. slider.Value .. suffix
        elseif info.HideMax then
            disp.Text = tostring(slider.Value) .. suffix
        else
            disp.Text = ("%s/%s"):format(slider.Value .. suffix, slider.Max .. suffix)
        end

        local w = inner.AbsoluteSize.X > 0 and inner.AbsoluteSize.X or 222
        local x = math.clamp(math.round(Library:MapValue(slider.Value, slider.Min, slider.Max, 0, w)), 0, w)
        TweenService:Create(fill, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(0, x, 1, 0) }):Play()
    end

    function slider:OnChanged(f) slider.Changed = f; f(slider.Value) end

    local function round(v)
        if slider.Rounding == 0 then return math.floor(v + 0.5) end
        return tonumber(string.format("%." .. slider.Rounding .. "f", v))
    end

    function slider:GetValueFromX(x)
        return round(Library:MapValue(x, 0, inner.AbsoluteSize.X, slider.Min, slider.Max))
    end

    function slider:SetValue(str)
        local n = tonumber(str)
        if not n then return end
        n = math.clamp(n, slider.Min, slider.Max)
        slider.Value = round(n)
        slider:Display()
        Library:SafeCallback(slider.Callback, slider.Value)
        Library:SafeCallback(slider.Changed, slider.Value)
    end

    inner.InputBegan:Connect(function(input)
        if Library:MouseIsOverOpenedFrame() then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local mPos = Mouse.X
            local gPos = fill.Size.X.Offset
            local diff = mPos - (fill.AbsolutePosition.X + gPos)
            while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
                local nx = math.clamp(gPos + (Mouse.X - mPos) + diff, 0, inner.AbsoluteSize.X)
                local nv = slider:GetValueFromX(nx)
                slider.Value = nv
                slider:Display()
                Library:SafeCallback(slider.Callback, slider.Value)
                Library:SafeCallback(slider.Changed, slider.Value)
                RunService.RenderStepped:Wait()
            end
            Library:AttemptSave()
        end
    end)

    inner:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() slider:Display() end)
    slider:Display()
    self:AddBlank(6)
    self:Resize()
    Library.Options[idx] = slider
    return slider
end

function BaseAddons:AddDropdown(idx, info)
    assert(info.Values, "AddDropdown: Values missing")
    assert(info.AllowNull or info.Default, "AddDropdown: Default missing")

    if not info.Text then info.Compact = true end

    local dropdown = {
        Values = info.Values,
        Value = info.Multi and {} or nil,
        Multi = info.Multi,
        Type = "Dropdown",
        SpecialType = info.SpecialType,
        Callback = info.Callback or function() end,
        ListHeight = 162,
        Opened = false,
    }

    local relOffset = 0
    if not info.Compact then
        CreateLabel({
            Size = UDim2.new(1, 0, 0, 10),
            TextSize = 14,
            Text = info.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Bottom,
            ZIndex = Z(self, 5),
            Parent = self.Container,
        })
        self:AddBlank(3)
    end

    local outer = Create("Frame", {
        BackgroundColor3 = Color3.new(0, 0, 0),
        BorderColor3 = Color3.new(0, 0, 0),
        Size = UDim2.new(1, -4, 0, 20),
        ZIndex = Z(self, 5),
        Parent = self.Container,
    })
    Library:AddToRegistry(outer, { BorderColor3 = "Black" })
    local inner = Create("Frame", {
        BackgroundColor3 = Library.MainColor,
        BorderColor3 = Library.OutlineColor,
        BorderMode = Enum.BorderMode.Inset,
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = Z(self, 6),
        Parent = outer,
    })
    Library:AddToRegistry(inner, { BackgroundColor3 = "MainColor", BorderColor3 = "OutlineColor" })
    Create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(212, 212, 212)),
        }),
        Rotation = 90, Parent = inner,
    })

    local arrow = CreateLabel({
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -5, 0.5, 0),
        Size = UDim2.new(0, 12, 1, 0),
        Text = "+",
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = Z(self, 8),
        Parent = inner,
    })

    local itemLabel = CreateLabel({
        Position = UDim2.new(0, 5, 0, 0),
        Size = UDim2.new(1, -20, 1, 0),
        TextSize = 14,
        Text = "--",
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        ZIndex = Z(self, 7),
        Parent = inner,
    })

    OnHighlight(outer, outer, { BorderColor3 = "AccentColor" }, { BorderColor3 = "Black" })
    if type(info.Tooltip) == "string" then AddToolTip(info.Tooltip, outer) end

    local MAX_ITEMS = 8

    local listOuter = Create("Frame", {
        BackgroundColor3 = Color3.new(0, 0, 0),
        BorderColor3 = Color3.new(0, 0, 0),
        ZIndex = 20,
        Visible = false,
        Parent = ScreenGui,
    })

    local function recalcPos()
        listOuter.Position = UDim2.fromOffset(outer.AbsolutePosition.X, outer.AbsolutePosition.Y + outer.Size.Y.Offset + 1)
    end
    local function recalcSize(y)
        y = y or (MAX_ITEMS * 20 + 2)
        dropdown.ListHeight = y
        if listOuter.Visible then listOuter.Size = UDim2.fromOffset(outer.AbsoluteSize.X, y) end
    end
    recalcPos(); recalcSize()

    outer:GetPropertyChangedSignal("AbsolutePosition"):Connect(recalcPos)

    local listInner = Create("Frame", {
        BackgroundColor3 = Library.MainColor,
        BorderColor3 = Library.OutlineColor,
        BorderMode = Enum.BorderMode.Inset,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = 21,
        Parent = listOuter,
    })
    Library:AddToRegistry(listInner, { BackgroundColor3 = "MainColor", BorderColor3 = "OutlineColor" })

    local scroll = Create("ScrollingFrame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = 21,
        Parent = listInner,
        TopImage = "rbxasset://textures/ui/Scroll/scroll-middle.png",
        BottomImage = "rbxasset://textures/ui/Scroll/scroll-middle.png",
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Library.AccentColor,
    })
    Library:AddToRegistry(scroll, { ScrollBarImageColor3 = "AccentColor" })
    Create("UIListLayout", { Padding = UDim.new(0, 0), FillDirection = Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })

    function dropdown:Display()
        local str = ""
        if info.Multi then
            for _, v in next, self.Values do
                if self.Value[v] then str = str .. v .. ", " end
            end
            str = str:sub(1, #str - 2)
        else
            str = self.Value or ""
        end
        itemLabel.Text = (str == "" and "..." or str)
    end

    function dropdown:GetActiveValues()
        if info.Multi then
            local t = {}
            for v, b in next, self.Value do table.insert(t, v) end
            return t
        else
            return self.Value and 1 or 0
        end
    end

    function dropdown:BuildDropdownList()
        local buttons = {}
        for _, e in next, scroll:GetChildren() do
            if not e:IsA("UIListLayout") then e:Destroy() end
        end
        local count = 0
        for _, value in next, self.Values do
            count = count + 1
            local t = {}
            local btn = Create("Frame", {
                BackgroundColor3 = Library.MainColor,
                BorderColor3 = Library.OutlineColor,
                BorderMode = Enum.BorderMode.Middle,
                Size = UDim2.new(1, -1, 0, 20),
                ZIndex = 23,
                Active = true,
                Parent = scroll,
            })
            Library:AddToRegistry(btn, { BackgroundColor3 = "MainColor", BorderColor3 = "OutlineColor" })
            local lbl = CreateLabel({
                Active = false,
                Size = UDim2.new(1, -6, 1, 0),
                Position = UDim2.new(0, 6, 0, 0),
                TextSize = 14,
                Text = value,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 25,
                Parent = btn,
            })
            OnHighlight(btn, btn, { BorderColor3 = "AccentColor", ZIndex = 24 }, { BorderColor3 = "OutlineColor", ZIndex = 23 })

            local selected
            if info.Multi then selected = self.Value[value]
            else selected = self.Value == value end

            function t:UpdateButton()
                if info.Multi then selected = self.Value[value]
                else selected = self.Value == value end
                lbl.TextColor3 = selected and Library.AccentColor or Library.FontColor
                if Library.RegistryMap[lbl] then Library.RegistryMap[lbl].Properties.TextColor3 = selected and "AccentColor" or "FontColor" end
            end

            lbl.InputBegan:Connect(function(input)
                if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                local try = not selected
                if self:GetActiveValues() == 1 and (not try) and (not info.AllowNull) then
                    -- do nothing
                else
                    if info.Multi then
                        selected = try
                        if selected then self.Value[value] = true else self.Value[value] = nil end
                    else
                        selected = try
                        if selected then self.Value = value else self.Value = nil end
                        for _, ob in next, buttons do ob:UpdateButton() end
                    end
                    t:UpdateButton()
                    self:Display()
                    Library:SafeCallback(self.Callback, self.Value)
                    Library:SafeCallback(self.Changed, self.Value)
                    Library:UpdateDependencyBoxes()
                    Library:AttemptSave()
                end
            end)

            t:UpdateButton()
            buttons[btn] = t
        end
        scroll.CanvasSize = UDim2.fromOffset(0, (count * 20) + 1)
        recalcSize(math.clamp(count * 20, 0, MAX_ITEMS * 20) + 1)
        self:Display()
    end

    function dropdown:SetValues(newValues)
        if newValues then self.Values = newValues end
        self:BuildDropdownList()
    end

    function dropdown:OpenDropdown()
        recalcPos()
        listOuter.Size = UDim2.fromOffset(outer.AbsoluteSize.X, 0)
        listOuter.Visible = true
        listOuter.ClipsDescendants = false
        listInner.ClipsDescendants = false
        Library.OpenedFrames[listOuter] = true
        TweenService:Create(listOuter, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(outer.AbsoluteSize.X, self.ListHeight or 162)
        }):Play()
        arrow.Text = "-"
        self.Opened = true
    end

    function dropdown:CloseDropdown()
        local tween = TweenService:Create(listOuter, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(outer.AbsoluteSize.X, 0)
        })
        arrow.Text = "+"
        tween.Completed:Connect(function()
            listOuter.Visible = false
            Library.OpenedFrames[listOuter] = nil
        end)
        tween:Play()
        self.Opened = false
    end

    function dropdown:OnChanged(f) self.Changed = f; f(self.Value) end
    function dropdown:SetValue(v)
        local prev = self.Value
        if self.Multi then
            local t = {}
            for val, b in next, v do
                if table.find(self.Values, val) then t[val] = true end
            end
            self.Value = t
        else
            if not v then self.Value = nil
            elseif table.find(self.Values, v) then self.Value = v end
        end
        if self.Value == prev then self:Display(); return end
        self:BuildDropdownList()
        Library:SafeCallback(self.Callback, self.Value)
        Library:SafeCallback(self.Changed, self.Value)
    end

    outer.InputBegan:Connect(function(input)
        if Library:MouseIsOverOpenedFrame() then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if listOuter.Visible then self:CloseDropdown() else self:OpenDropdown() end
        end
    end)

    Library:GiveSignal(UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local ap, as = listOuter.AbsolutePosition, listOuter.AbsoluteSize
            if Mouse.X < ap.X or Mouse.X > ap.X + as.X or Mouse.Y < ap.Y - 21 or Mouse.Y > ap.Y + as.Y then
                self:CloseDropdown()
            end
        end
    end))

    self:BuildDropdownList()

    if info.Default then
        if type(info.Default) == "string" then
            local i = table.find(self.Values, info.Default)
            if i then self.Value = info.Default end
        elseif type(info.Default) == "table" then
            for _, v in next, info.Default do
                if table.find(self.Values, v) then
                    if self.Multi then self.Value[v] = true else self.Value = v; break end
                end
            end
        elseif type(info.Default) == "number" and self.Values[info.Default] then
            if self.Multi then self.Value[self.Values[info.Default]] = true else self.Value = self.Values[info.Default] end
        end
        self:BuildDropdownList()
    end
    self:Display()

    self:AddBlank(5)
    self:Resize()
    Library.Options[idx] = dropdown
    return dropdown
end

function BaseAddons:AddDependencyBox()
    local dep = { Dependencies = {} }
    local holder = Create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        Visible = false,
        ZIndex = 1,
        Parent = self.Container,
    })
    local frame = Create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = 1,
        Parent = holder,
    })
    local layout = Create("UIListLayout", { FillDirection = Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder, Parent = frame })

    function dep:Resize()
        holder.Size = UDim2.new(1, 0, 0, layout.AbsoluteContentSize.Y)
        self.Groupbox:Resize()
    end

    function dep:Update()
        for _, d in next, dep.Dependencies do
            local elem, expected = d[1], d[2]
            local cur = elem.Value
            if cur == nil or cur ~= expected then
                holder.Visible = false
                dep:Resize()
                return
            end
        end
        holder.Visible = true
        dep:Resize()
    end

    function dep:SetupDependencies(deps)
        for _, d in next, deps do
            assert(type(d) == "table" and d[1] and d[2] ~= nil, "SetupDependencies: bad dependency")
        end
        dep.Dependencies = deps
        dep:Update()
    end

    dep.Container = frame
    setmetatable(dep, BaseGroupbox)
    table.insert(Library.DependencyBoxes, dep)
    return dep
end

-- aliases for BaseGroupbox construction
BaseGroupbox.__index = BaseGroupbox

-- patch groupbox construction to call BaseGroupbox methods when AddX called via : syntax
local oldMakeGroupbox = Library.MakeGroupbox
LibMakeGroupbox = function(parent, name, rightSide)
    local box = Create("Frame", {
        BackgroundColor3 = Library.BackgroundColor,
        BorderColor3 = Library.OutlineColor,
        BorderMode = Enum.BorderMode.Inset,
        Size = UDim2.new(1, 0, 0, 0),
        ZIndex = 6,
        Parent = parent,
    })
    Library:AddToRegistry(box, { BackgroundColor3 = "BackgroundColor", BorderColor3 = "OutlineColor" })

    local boxInner = Create("Frame", {
        BackgroundColor3 = Library.BackgroundColor,
        BorderColor3 = Color3.new(0, 0, 0),
        Size = UDim2.new(1, -2, 1, -2),
        Position = UDim2.new(0, 1, 0, 1),
        ZIndex = 7,
        Parent = box,
    })
    Library:AddToRegistry(boxInner, { BackgroundColor3 = "BackgroundColor" })

    local hl = Create("Frame", {
        BackgroundColor3 = Library.AccentColor,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 2),
        ZIndex = 8,
        Parent = boxInner,
    })
    Library:AddToRegistry(hl, { BackgroundColor3 = "AccentColor" })

    CreateLabel({
        Size = UDim2.new(1, 0, 0, 18),
        Position = UDim2.new(0, 4, 0, 2),
        TextSize = 14,
        Text = name,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 9,
        Parent = boxInner,
    })

    local container = Create("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 6, 0, 20),
        Size = UDim2.new(1, -8, 1, -20),
        ZIndex = 10,
        Parent = boxInner,
    })
    Create("UIListLayout", { FillDirection = Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder, Parent = container })
    local ll = container:FindFirstChildOfClass("UIListLayout")

    local gb = setmetatable({}, BaseGroupbox)
    gb.Container = container
    gb.Frame = box
    gb.Groupbox = gb

    function gb:Resize()
        local size, sum, count = 0, 0, 0
        for _, e in next, container:GetChildren() do
            if not e:IsA("UIListLayout") and e.Visible then
                count = count + 1
                sum = sum + e.Size.Y.Offset
            end
        end
        if count > 1 and ll then sum = sum + ll.Padding.Offset * (count - 1) end
        if ll then size = ll.AbsoluteContentSize.Y end
        size = math.max(size, sum)
        box.Size = UDim2.new(1, 0, 0, 20 + size + 4)
    end
    ll:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() gb:Resize() end)

    return gb
end
