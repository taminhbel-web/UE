function BaseAddons:AddInput(idx, info)
    assert(info.Text, "AddInput: Text missing")
    local tb = { Value = info.Default or "", Numeric = info.Numeric or false, Finished = info.Finished or false, Type = "Input", Callback = info.Callback or function() end }

    if not info.NoLabel then
        CreateLabel({
            Size = UDim2.new(1, 0, 0, 15),
            TextSize = 14,
            Text = info.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = Z(self, 5),
            Parent = self.Container,
        })
        self:AddBlank(1)
    end

    local outer = Create("Frame", {
        BackgroundColor3 = Color3.new(0, 0, 0),
        BorderColor3 = Color3.new(0, 0, 0),
        Size = UDim2.new(1, -4, 0, 20),
        ZIndex = Z(self, 5),
        Parent = self.Container,
    })
    local inner = Create("Frame", {
        BackgroundColor3 = Library.MainColor,
        BorderColor3 = Library.OutlineColor,
        BorderMode = Enum.BorderMode.Inset,
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = Z(self, 6),
        Parent = outer,
    })
    Library:AddToRegistry(inner, { BackgroundColor3 = "MainColor", BorderColor3 = "OutlineColor" })
    OnHighlight(outer, outer, { BorderColor3 = "AccentColor" }, { BorderColor3 = "Black" })
    if type(info.Tooltip) == "string" then AddToolTip(info.Tooltip, outer) end

    local box = Create("TextBox", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(5, 2),
        Size = UDim2.new(1, -10, 1, -4),
        Font = Library.Font,
        PlaceholderColor3 = Color3.fromRGB(120, 120, 120),
        PlaceholderText = info.Placeholder or "",
        Text = info.Default or "",
        TextColor3 = Library.FontColor,
        TextSize = 14,
        TextStrokeTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        ZIndex = Z(self, 7),
        Parent = inner,
    })
    Library:AddToRegistry(box, { TextColor3 = "FontColor" })

    function tb:SetValue(text)
        if info.MaxLength and #text > info.MaxLength then text = text:sub(1, info.MaxLength) end
        if tb.Numeric and not tonumber(text) and #text > 0 then text = tb.Value end
        tb.Value = text
        box.Text = text
        Library:SafeCallback(tb.Callback, tb.Value)
        Library:SafeCallback(tb.Changed, tb.Value)
    end

    if tb.Finished then
        box.FocusLost:Connect(function() tb:SetValue(box.Text) end)
    else
        box:GetPropertyChangedSignal("Text"):Connect(function() tb:SetValue(box.Text) end)
    end

    function tb:OnChanged(f)
        tb.Changed = f
        f(tb.Value)
    end

    self:AddBlank(5)
    self:Resize()
    Library.Options[idx] = tb
    return tb
end

function BaseAddons:AddToggle(idx, info)
    assert(info.Text, "AddToggle: Text missing")
    local toggle = {
        Value = info.Default or false,
        Type = "Toggle",
        Callback = info.Callback or function() end,
        Addons = {},
        Risky = info.Risky,
    }

    local outer = Create("Frame", {
        BackgroundColor3 = Color3.new(0, 0, 0),
        BorderColor3 = Color3.new(0, 0, 0),
        Size = UDim2.new(0, 13, 0, 13),
        ZIndex = Z(self, 5),
        Parent = self.Container,
    })
    Library:AddToRegistry(outer, { BorderColor3 = "Black" })
    local inner = Create("Frame", {
        BackgroundColor3 = Library.MainColor,
        BorderColor3 = Library.OutlineColor,
        BorderMode = Enum.BorderMode.Inset,
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = Z(self, 6),
        Parent = outer,
    })
    Library:AddToRegistry(inner, { BackgroundColor3 = "MainColor", BorderColor3 = "OutlineColor" })

    local label = CreateLabel({
        Size = UDim2.new(0, 216, 1, 0),
        Position = UDim2.new(1, 6, 0, 0),
        TextSize = 14,
        Text = info.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = Z(self, 6),
        Parent = inner,
    })
    Create("UIListLayout", { Padding = UDim.new(0, 4), FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, SortOrder = Enum.SortOrder.LayoutOrder, Parent = label })

    local region = Create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 170, 1, 0),
        ZIndex = Z(self, 8),
        Parent = outer,
    })
    OnHighlight(region, outer, { BorderColor3 = "AccentColor" }, { BorderColor3 = "Black" })
    if type(info.Tooltip) == "string" then AddToolTip(info.Tooltip, region) end

    function toggle:Display()
        inner.BackgroundColor3 = toggle.Value and Library.AccentColor or Library.MainColor
        inner.BorderColor3 = toggle.Value and Library.AccentColor or Library.OutlineColor
        if Library.RegistryMap[inner] then
            Library.RegistryMap[inner].Properties.BackgroundColor3 = toggle.Value and "AccentColor" or "MainColor"
            Library.RegistryMap[inner].Properties.BorderColor3 = toggle.Value and "AccentColor" or "OutlineColor"
        end
    end

    function toggle:OnChanged(f) toggle.Changed = f; f(toggle.Value) end

    function toggle:SetValue(v)
        v = not not v
        toggle.Value = v
        toggle:Display()
        for _, addon in next, toggle.Addons do
            if addon.Type == "KeyPicker" and addon.SyncToggleState then
                addon.Toggled = v
                addon:Update()
            end
        end
        Library:SafeCallback(toggle.Callback, toggle.Value)
        Library:SafeCallback(toggle.Changed, toggle.Value)
        Library:UpdateDependencyBoxes()
    end

    region.InputBegan:Connect(function(input)
        if Library:MouseIsOverOpenedFrame() then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            toggle:SetValue(not toggle.Value)
            Library:AttemptSave()
        end
    end)

    if toggle.Risky then
        Library:RemoveFromRegistry(label)
        label.TextColor3 = Library.RiskColor
        Library:AddToRegistry(label, { TextColor3 = "RiskColor" })
    end

    toggle:Display()
    self:AddBlank(5 + 2)
    self:Resize()

    toggle.TextLabel = label
    toggle.Container = self.Container
    setmetatable(toggle, BaseAddons)

    Library.Toggles[idx] = toggle
    Library:UpdateDependencyBoxes()
    return toggle
end

function BaseAddons:AddKeyPicker(idx, info)
    local parent = self
    local toggleLbl = self.TextLabel
    local container = self.Container

    assert(info.Default, "AddKeyPicker: Default missing")

    local picker = {
        Value = info.Default,
        Toggled = false,
        Mode = info.Mode or "Toggle",
        Type = "KeyPicker",
        Callback = info.Callback or function() end,
        ChangedCallback = info.ChangedCallback or function() end,
        SyncToggleState = info.SyncToggleState or false,
    }

    if picker.SyncToggleState then
        info.Modes = { "Toggle" }
        info.Mode = "Toggle"
        if parent.Type == "Toggle" then picker.Toggled = not not parent.Value end
    end

    local outer = Create("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 28, 0, 15),
        ZIndex = toggleLbl.ZIndex + 1,
        Parent = toggleLbl,
    })
    local inner = Create("Frame", {
        BackgroundColor3 = Library.MainColor,
        BorderColor3 = Library.OutlineColor,
        BorderMode = Enum.BorderMode.Inset,
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = toggleLbl.ZIndex + 2,
        Parent = outer,
    })
    Library:AddToRegistry(inner, { BackgroundColor3 = "MainColor", BorderColor3 = "OutlineColor" })

    local displayLbl = CreateLabel({
        Size = UDim2.new(1, -4, 1, 0),
        Position = UDim2.new(0, 2, 0, 0),
        TextSize = 12,
        TextColor3 = Color3.new(1, 1, 1),
        Text = info.Default == "None" and "( - )" or info.Default,
        ZIndex = toggleLbl.ZIndex + 3,
        Parent = inner,
    })

    local modes = info.Modes or { "Always", "Toggle", "Hold" }
    local modeButtons = {}

    local modeSelect = Create("Frame", {
        BorderColor3 = Color3.new(0, 0, 0),
        Position = UDim2.fromOffset(toggleLbl.AbsolutePosition.X + toggleLbl.AbsoluteSize.X + 4, toggleLbl.AbsolutePosition.Y + 1),
        Size = UDim2.new(0, 60, 0, 45 + 2),
        Visible = false,
        ZIndex = 15,
        Parent = ScreenGui,
    })
    local modeInner = Create("Frame", {
        BackgroundColor3 = Library.BackgroundColor,
        BorderColor3 = Library.OutlineColor,
        BorderMode = Enum.BorderMode.Inset,
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = 16,
        Parent = modeSelect,
    })
    Library:AddToRegistry(modeInner, { BackgroundColor3 = "BackgroundColor", BorderColor3 = "OutlineColor" })
    Create("UIListLayout", { FillDirection = Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder, Parent = modeInner })

    for _, mode in next, modes do
        local mb = {}
        local lbl = CreateLabel({
            Active = false,
            Size = UDim2.new(1, 0, 0, 15),
            TextSize = 13,
            Text = mode,
            ZIndex = 17,
            Parent = modeInner,
        })
        function mb:Select()
            for _, b in next, modeButtons do b:Deselect() end
            picker.Mode = mode
            lbl.TextColor3 = Library.AccentColor
            if Library.RegistryMap[lbl] then Library.RegistryMap[lbl].Properties.TextColor3 = "AccentColor" end
            modeSelect.Visible = false
        end
        function mb:Deselect()
            picker.Mode = nil
            lbl.TextColor3 = Library.FontColor
            if Library.RegistryMap[lbl] then Library.RegistryMap[lbl].Properties.TextColor3 = "FontColor" end
        end
        lbl.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                mb:Select()
                Library:AttemptSave()
            end
        end)
        if mode == picker.Mode then mb:Select() end
        modeButtons[mode] = mb
    end

    function picker:GetState()
        if picker.Mode == "Always" then return true
        elseif picker.Mode == "Hold" then
            if picker.Value == "None" then return false end
            local k = picker.Value
            if k == "MB1" then return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
            elseif k == "MB2" then return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
            else return UserInputService:IsKeyDown(Enum.KeyCode[k]) end
        else
            return picker.Toggled
        end
    end

    function picker:SetValue(data)
        local key, mode = data[1], data[2]
        displayLbl.Text = key
        modeButtons[mode]:Select()
        picker:Update()
    end

    function picker:OnClick(cb) picker.Clicked = cb end
    function picker:OnChanged(cb) picker.Changed = cb; cb(picker.Value) end
    function picker:Update() end
    function picker:DoClick()
        if parent.Type == "Toggle" and picker.SyncToggleState then
            parent:SetValue(not parent.Value)
        end
        Library:SafeCallback(picker.Callback, picker.Toggled)
        Library:SafeCallback(picker.Clicked, picker.Toggled)
    end

    local picking = false
    outer.InputBegan:Connect(function(input)
        if Library:MouseIsOverOpenedFrame() then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            picking = true
            displayLbl.Text = ""
            local done = false
            task.spawn(function()
                while not done do
                    displayLbl.Text = displayLbl.Text == "..." and "." or displayLbl.Text .. "."
                    task.wait(0.4)
                end
            end)
            task.wait(0.2)
            local evt
            evt = UserInputService.InputBegan:Connect(function(i)
                local key
                if i.UserInputType == Enum.UserInputType.Keyboard then key = i.KeyCode.Name
                elseif i.UserInputType == Enum.UserInputType.MouseButton1 then key = "MB1"
                elseif i.UserInputType == Enum.UserInputType.MouseButton2 then key = "MB2" end
                if key == "Escape" or key == "Backspace" then key = "None" end
                done = true
                picking = false
                displayLbl.Text = key
                picker.Value = key
                Library:SafeCallback(picker.ChangedCallback, i.KeyCode or i.UserInputType)
                Library:SafeCallback(picker.Changed, i.KeyCode or i.UserInputType)
                Library:AttemptSave()
                evt:Disconnect()
            end)
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
            modeSelect.Visible = true
        end
    end)

    Library:GiveSignal(UserInputService.InputBegan:Connect(function(input)
        if not picking then
            if picker.Mode == "Toggle" then
                local k = picker.Value
                if k == "MB1" and input.UserInputType == Enum.UserInputType.MouseButton1 then
                    picker.Toggled = not picker.Toggled
                    picker:DoClick()
                elseif k == "MB2" and input.UserInputType == Enum.UserInputType.MouseButton2 then
                    picker.Toggled = not picker.Toggled
                    picker:DoClick()
                elseif input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name == k then
                    picker.Toggled = not picker.Toggled
                    picker:DoClick()
                end
            end
        end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local ap, as = modeSelect.AbsolutePosition, modeSelect.AbsoluteSize
            if Mouse.X < ap.X or Mouse.X > ap.X + as.X or Mouse.Y < ap.Y - 21 or Mouse.Y > ap.Y + as.Y then
                modeSelect.Visible = false
            end
        end
    end))

    if parent.Addons then table.insert(parent.Addons, picker) end
    Library.Options[idx] = picker
    return self
end

function BaseAddons:AddColorPicker(idx, info)
    local toggleLbl = self.TextLabel
    assert(info.Default, "AddColorPicker: Default missing")

    local picker = {
        Value = info.Default,
