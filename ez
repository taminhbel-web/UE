            Library:AddToRegistry(box, { BackgroundColor3 = "BackgroundColor", BorderColor3 = "OutlineColor" })

            local boxInner = Create("Frame", {
                BackgroundColor3 = Library.BackgroundColor,
                BorderColor3 = Color3.new(0, 0, 0),
                Size = UDim2.new(1, -2, 1, -2),
                Position = UDim2.new(0, 1, 0, 1),
                ZIndex = 7,
                Parent = box,
            })
            Library:AddToRegistry(boxInner, { BackgroundColor3 = "BackgroundColor" })

            local btnRow = Create("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 18),
                ZIndex = 8,
                Parent = boxInner,
            })
            Create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Left, SortOrder = Enum.SortOrder.LayoutOrder, Parent = btnRow })

            function tb:AddTab(name)
                local t = {}
                local btn = Create("Frame", {
                    BackgroundColor3 = Library.MainColor,
                    BorderColor3 = Color3.new(0, 0, 0),
                    Size = UDim2.new(0.5, 0, 1, 0),
                    ZIndex = 6,
                    Parent = btnRow,
                })
                Library:AddToRegistry(btn, { BackgroundColor3 = "MainColor" })
                local lbl = CreateLabel({ Size = UDim2.new(1, 0, 1, 0), Text = name, TextSize = 14, ZIndex = 7, Parent = btn })

                local block = Create("Frame", {
                    BackgroundColor3 = Library.BackgroundColor,
                    BorderSizePixel = 0,
                    Position = UDim2.new(0, 0, 1, 0),
                    Size = UDim2.new(1, 0, 0, 1),
                    Visible = false,
                    ZIndex = 9,
                    Parent = btn,
                })
                Library:AddToRegistry(block, { BackgroundColor3 = "BackgroundColor" })

                local cont = Create("Frame", {
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 6, 0, 20),
                    Size = UDim2.new(1, -8, 1, -20),
                    Visible = false,
                    ZIndex = 10,
                    Parent = boxInner,
                })
                local underline = Create("Frame", {
                    BackgroundColor3 = Library.AccentColor,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 2),
                    Visible = false,
                    ZIndex = 10,
                    Parent = btn,
                })
                Library:AddToRegistry(underline, { BackgroundColor3 = "AccentColor" })
                Create("UIListLayout", { FillDirection = Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder, Parent = cont })

                function t:Show()
                    for _, x in next, tb.Tabs do x:Hide() end
                    cont.Visible = true
                    block.Visible = true
                    underline.Visible = true
                    btn.BackgroundColor3 = Library.BackgroundColor
                    if Library.RegistryMap[btn] then Library.RegistryMap[btn].Properties.BackgroundColor3 = "BackgroundColor" end
                    t:Resize()
                end
                function t:Hide()
                    cont.Visible = false
                    block.Visible = false
                    underline.Visible = false
                    btn.BackgroundColor3 = Library.MainColor
                    if Library.RegistryMap[btn] then Library.RegistryMap[btn].Properties.BackgroundColor3 = "MainColor" end
                end
                function t:Resize()
                    local cnt = 0
                    for _ in next, tb.Tabs do cnt = cnt + 1 end
                    for _, b in next, btnRow:GetChildren() do
                        if not b:IsA("UIListLayout") then b.Size = UDim2.new(1/cnt, 0, 1, 0) end
                    end
                    if not cont.Visible then return end
                    local size = 0
                    for _, e in next, cont:GetChildren() do
                        if not e:IsA("UIListLayout") and e.Visible then size = size + e.Size.Y.Offset end
                    end
                    box.Size = UDim2.new(1, 0, 0, 20 + size + 4)
                end

                btn.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        t:Show()
                        t:Resize()
                    end
                end)

                t.Container = cont
                setmetatable(t, BaseGroupbox)
                tb.Tabs[name] = t
                t:AddBlank(3)
                t:Resize()
                if #btnRow:GetChildren() == 2 then t:Show() end
                return t
            end

            tab.Tabboxes[info.Name or ""] = tb
            return tb
        end

        function tab:AddLeftTabbox(name) return tab:AddTabbox({ Name = name, Side = 1 }) end
        function tab:AddRightTabbox(name) return tab:AddTabbox({ Name = name, Side = 2 }) end

        win.Tabs[name] = tab
        if not win.SelectedTab then selectTab() end
        return tab
    end

    -- menu keybind
    Library:GiveSignal(UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.RightShift then
            win:Toggle()
        end
    end))

    if cfg.AutoShow then win:Toggle() end

    return win
end

