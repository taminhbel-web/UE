-- Groupbox base
--------------------------------------------------------------------
BaseGroupbox = {}
local BaseAddons = {}
BaseAddons.__index = BaseAddons

local function Z(gb, layer)
    return (gb.ContentBaseZIndex or 10) + layer
end

function BaseGroupbox:AddBlank(size)
    Create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, size or 0),
        Parent = self.Container,
    })
end

function BaseGroupbox.__index(_, key)
    return BaseAddons[key]
end

BaseGroupbox.__namecall = function(t, key, ...)
    local fn = rawget(BaseAddons, key)
    if fn then return fn(t, ...) end
end

function BaseAddons:AddLabel(text, wrap)
    local lbl = {}
    local textLbl = CreateLabel({
        Size = UDim2.new(1, -4, 0, 15),
        TextSize = 14,
        Text = text,
        TextWrapped = wrap or false,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = Z(self, 5),
        Parent = self.Container,
    })
    if wrap then
        local _, y = Library:GetTextBounds(text, Library.Font, 14, Vector2.new(textLbl.AbsoluteSize.X, math.huge))
        textLbl.Size = UDim2.new(1, -4, 0, y)
    else
        Create("UIListLayout", { Padding = UDim.new(0, 4), FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, SortOrder = Enum.SortOrder.LayoutOrder, Parent = textLbl })
    end
    lbl.TextLabel = textLbl
    lbl.Container = self.Container
    function lbl:SetText(t)
        textLbl.Text = t
        if wrap then
            local _, y = Library:GetTextBounds(t, Library.Font, 14, Vector2.new(textLbl.AbsoluteSize.X, math.huge))
            textLbl.Size = UDim2.new(1, -4, 0, y)
        end
        self.Groupbox:Resize()
    end
    if not wrap then setmetatable(lbl, BaseAddons) end
    self:AddBlank(5)
    self:Resize()
    return lbl
end

function BaseAddons:AddButton(...)
    local btn = {}
    local args = { ... }
    if type(args[1]) == "table" then
        btn.Text = args[1].Text
        btn.Func = args[1].Func
        btn.DoubleClick = args[1].DoubleClick
        btn.Tooltip = args[1].Tooltip
    else
        btn.Text = args[1]
        btn.Func = args[2]
    end
    assert(type(btn.Func) == "function", "AddButton: Func missing")

    local outer = Create("Frame", {
        BackgroundColor3 = Color3.new(0, 0, 0),
        BorderColor3 = Color3.new(0, 0, 0),
        Size = UDim2.new(1, -4, 0, 20),
        ZIndex = Z(self, 5),
        Parent = self.Container,
    })
    local inner = Create("Frame", {
        BackgroundColor3 = Library.MainColor,
        BorderColor3 = Library.OutlineColor,
        BorderMode = Enum.BorderMode.Inset,
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = Z(self, 6),
        Parent = outer,
    })
    local label = CreateLabel({
        Size = UDim2.new(1, 0, 1, 0),
        TextSize = 14,
        Text = btn.Text,
        ZIndex = Z(self, 6),
        Parent = inner,
    })
    Create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(212, 212, 212)),
        }),
        Rotation = 90,
        Parent = inner,
    })
    Library:AddToRegistry(outer, { BorderColor3 = "Black" })
    Library:AddToRegistry(inner, { BackgroundColor3 = "MainColor", BorderColor3 = "OutlineColor" })
    OnHighlight(outer, outer, { BorderColor3 = "AccentColor" }, { BorderColor3 = "Black" })

    local locked = false
    outer.InputBegan:Connect(function(input)
        if Library:MouseIsOverOpenedFrame() then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if locked then return end
            if btn.DoubleClick then
                locked = true
                Library:RemoveFromRegistry(label)
                Library:AddToRegistry(label, { TextColor3 = "AccentColor" })
                label.TextColor3 = Library.AccentColor
                label.Text = "Are you sure?"
                task.delay(0.5, function()
                    locked = false
                    Library:RemoveFromRegistry(label)
                    Library:AddToRegistry(label, { TextColor3 = "FontColor" })
                    label.TextColor3 = Library.FontColor
                    label.Text = btn.Text
                end)
                return
            end
            Library:SafeCallback(btn.Func)
        end
    end)

    function btn:SetText(t) btn.Text = t; label.Text = t end
    function btn:AddTooltip(str) if type(str) == "string" then AddToolTip(str, outer) end end
    function btn:AddButton(...)
        local sub = {}
        local a = { ... }
        sub.Text = type(a[1]) == "table" and a[1].Text or a[1]
        sub.Func = type(a[1]) == "table" and a[1].Func or a[2]
        outer.Size = UDim2.new(0.5, -2, 0, 20)
        local sOuter = outer:Clone()
        sOuter.Position = UDim2.new(1, 3, 0, 0)
        sOuter.Size = UDim2.fromOffset(outer.AbsoluteSize.X - 2, outer.AbsoluteSize.Y)
        sOuter.Parent = outer
        local sLbl = sOuter:FindFirstChildWhichIsA("TextLabel") or sOuter:FindFirstChild("Frame"):FindFirstChildWhichIsA("TextLabel")
        if sLbl then sLbl.Text = sub.Text end
        sOuter.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then Library:SafeCallback(sub.Func) end
        end)
        return sub
    end

    if type(btn.Tooltip) == "string" then btn:AddTooltip(btn.Tooltip) end
    self:AddBlank(5)
    self:Resize()
    return btn
end

