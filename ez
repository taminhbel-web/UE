function Library:Notify(text, duration)
    duration = duration or 4
    local textSize = 14
    local padX, padY, barH = 10, 6, 2
    local X, Y = Library:GetTextBounds(text, Library.Font, textSize)
    local w = math.ceil(X + padX * 2 + 20)
    local h = math.ceil(Y + padY * 2 + barH + 4)

    Library.NotificationIndex = Library.NotificationIndex + 1

    local outer = Create("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        LayoutOrder = Library.NotificationIndex,
        Size = UDim2.fromOffset(w, h),
        ZIndex = 100,
        Parent = NotifyArea,
    })

    local inner = Create("Frame", {
        BackgroundColor3 = Library.BackgroundColor,
        BorderColor3 = Library.OutlineColor,
        BorderMode = Enum.BorderMode.Inset,
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = 101,
        Parent = outer,
    })
    Library:AddToRegistry(inner, { BackgroundColor3 = "BackgroundColor", BorderColor3 = "OutlineColor" }, true)

    inner.Position = UDim2.fromOffset(w, 0)
    local ti = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(inner, ti, { Position = UDim2.fromOffset(0, 0) }):Play()

    local lbl = CreateLabel({
        Position = UDim2.new(0, padX, 0, padY),
        Size = UDim2.new(1, -padX * 2, 1, -(padY * 2 + barH)),
        Text = text,
        RichText = true,
        TextSize = textSize,
        TextWrapped = false,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = 103,
        Parent = inner,
    })
    Library:AddToRegistry(lbl, { TextColor3 = "FontColor" }, true)

    local bar = Create("Frame", {
        BackgroundColor3 = Library.AccentColor,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 1, -barH),
        Size = UDim2.new(1, 0, 0, barH),
        ZIndex = 104,
        Parent = inner,
    })
    Library:AddToRegistry(bar, { BackgroundColor3 = "AccentColor" }, true)

    TweenService:Create(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, barH) }):Play()

    task.delay(duration, function()
        local to = TweenService:Create(inner, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.fromOffset(w, 0) })
        to:Play()
        to.Completed:Connect(function() outer:Destroy() end)
    end)
end

--------------------------------------------------------------------
-- Draggable
--------------------------------------------------------------------
function Library:MakeDraggable(instance, cutoff)
    instance.Active = true
    local dragging, dragInput, dragStart, startPos
    cutoff = cutoff or 40

    instance.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if (input.Position.Y - instance.AbsolutePosition.Y) > cutoff then return end
            dragging = true
            dragStart = input.Position
            startPos = instance.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            instance.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

