            AutoButtonColor = false,
            ZIndex = 56,
            Parent = row,
        })
        Library:Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = btn })
        Library:Create("UIPadding", { PaddingLeft = UDim.new(0, 8), Parent = btn })

        local expander = Library:Create("Frame", {
            BackgroundColor3 = Library.BackgroundColor,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 0),
            Position = UDim2.new(0, 0, 1, 2),
            AutomaticSize = Enum.AutomaticSize.Y,
            Visible = false,
            ZIndex = 60,
            Parent = row,
        })
        Library:Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = expander })
        Library:Create("UIStroke", {
            Color = Library.OutlineColor,
            Thickness = 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Parent = expander,
        })
        Library:Create("UIListLayout", {
            Padding = UDim.new(0, 2),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = expander,
        })

        local dropdownApi = {
            Value = val,
            Values = values,
            SetVisible = function(_, v) row.Visible = v end,
        }

        local function rebuild()
            for _, c in ipairs(expander:GetChildren()) do
                if not c:IsA("UIListLayout") then c:Destroy() end
            end
            for i, v in ipairs(values) do
                local o = Library:Create("TextButton", {
                    BackgroundColor3 = Library.BackgroundColor,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 20),
                    Font = Library.Font,
                    TextSize = 11,
                    TextColor3 = Library.SubTextColor,
                    Text = tostring(v),
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false,
                    LayoutOrder = i,
                    ZIndex = 61,
                    Parent = expander,
                })
                Library:Create("UIPadding", { PaddingLeft = UDim.new(0, 8), Parent = o })
                o.MouseEnter:Connect(function()
                    o.BackgroundColor3 = Library.ElementHover
                    o.TextColor3 = Library.FontColor
                end)
                o.MouseLeave:Connect(function()
                    o.BackgroundColor3 = Library.BackgroundColor
                    o.TextColor3 = Library.SubTextColor
                end)
                o.MouseButton1Click:Connect(function()
                    val = v
                    btn.Text = tostring(v)
                    dropdownApi.Value = v
                    expander.Visible = false
                    Library:SafeCallback(config.Callback, v)
                end)
            end
        end
        rebuild()

        btn.MouseButton1Click:Connect(function()
            expander.Visible = not expander.Visible
        end)

        function dropdownApi.SetValue(_, v)
            val = v
            btn.Text = tostring(v)
            dropdownApi.Value = v
            Library:SafeCallback(config.Callback, v)
        end

        function dropdownApi.SetValues(_, newVals)
            values = newVals
            dropdownApi.Values = newVals
            rebuild()
        end

        Library.Options[idx] = dropdownApi
        return dropdownApi
    end

