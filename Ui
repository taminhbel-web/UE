function Library:SetTheme(themeName)
    local theme = Library.Themes[themeName]
    if not theme then return end
    for key, value in next, theme do
        Library[key] = value
    end
    Library.CurrentTheme = themeName
    Library:UpdateColorsUsingRegistry()
end

