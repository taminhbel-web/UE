    }

    -- TOGGLE
    function groupbox:AddToggle(idx, config)
        config = config or {}
        local row = Library:Create("Frame", {
            BackgroundColor3 = Library.TertiaryColor,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 30),
            LayoutOrder = #holder:GetChildren(),
            ZIndex = 55,
            Parent = holder,
        })
        Library:Create("UICorner", { CornerRadius = UDim.new(0, 5), Parent = row })

        local label = Library:Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -70, 1, 0),
            Position = UDim2.new(0, 10, 0, 0),
            Font = Library.Font,
            TextSize = 12,
            TextColor3 = Library.FontColor,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = config.Text or idx,
            ZIndex = 56,
            Parent = row,
        })

        local track = Library:Create("Frame", {
            BackgroundColor3 = Library.BackgroundColor,
            BorderSizePixel = 0,
            Size = UDim2.new(0, 32, 0, 16),
            Position = UDim2.new(1, -40, 0.5, -8),
            ZIndex = 56,
            Parent = row,
        })
        Library:Create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = track })

        local knob = Library:Create("Frame", {
            BackgroundColor3 = Library.SubTextColor,
            BorderSizePixel = 0,
            Size = UDim2.new(0, 12, 0, 12),
            Position = UDim2.new(0, 2, 0.5, -6),
            ZIndex = 57,
            Parent = track,
        })
        Library:Create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = knob })

        local state = config.Default or false
        local function render()
            TweenService:Create(knob, TweenInfo.new(0.15), {
                Position = state and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6),
                BackgroundColor3 = state and Library.AccentColor or Library.SubTextColor,
            }):Play()
        end

        local function set(v, silent)
            state = v and true or false
            render()
            if not silent then
                Library:SafeCallback(config.Callback, state)
            end
        end

        row.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                set(not state)
                Library:AttemptSave()
            end
        end)
        render()

        local toggleApi = {
            Value = state,
            SetValue = set,
            SetVisible = function(_, v) row.Visible = v end,
            Instance = row,
        }

        function toggleApi:AddKeyPicker(idx2, config2)
            config2 = config2 or {}
            local keyState = config2.Default or "None"
            local btn = Library:Create("TextButton", {
                BackgroundColor3 = Library.BackgroundColor,
                BorderSizePixel = 0,
                Size = UDim2.new(0, 56, 0, 20),
                Position = UDim2.new(1, -102, 0.5, -10),
                Font = Library.Font,
                TextSize = 11,
                TextColor3 = Library.SubTextColor,
                Text = keyState,
                AutoButtonColor = false,
                ZIndex = 56,
                Parent = row,
            })
            Library:Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = btn })

            local picking = false
            btn.MouseButton1Click:Connect(function()
                picking = true
                btn.Text = "..."
            end)

            UserInputService.InputBegan:Connect(function(input)
                if picking then
                    picking = false
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        keyState = input.KeyCode.Name
                    elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
                        keyState = "MB1"
                    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
                        keyState = "MB2"
                    end
                    btn.Text = keyState
                    return
                end

                local pressed
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    pressed = input.KeyCode.Name
                elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
                    pressed = "MB1"
                elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
                    pressed = "MB2"
                end

                if pressed and keyState ~= "None" and pressed == keyState then
                    if config2.SyncToggleState ~= false then
                        set(not state)
                    else
                        Library:SafeCallback(config2.Callback, true)
                    end
                end
            end)

            local keyApi = {
                Value = keyState,
                SetValue = function(_, v) keyState = v; btn.Text = v end,
                SetVisible = function(_, v) btn.Visible = v end,
            }
            Library.Options[idx2] = keyApi
            return keyApi
        end

        function toggleApi:AddColorPicker(idx2, config2)
            config2 = config2 or {}
            local col = config2.Default or Color3.new(1, 1, 1)
            local prev = Library:Create("TextButton", {
                BackgroundColor3 = col,
                BorderSizePixel = 0,
                Size = UDim2.new(0, 24, 0, 16),
                Position = UDim2.new(1, -134, 0.5, -8),
                Text = "",
                AutoButtonColor = false,
                ZIndex = 56,
                Parent = row,
            })
            Library:Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = prev })
            Library:Create("UIStroke", {
                Color = Library.OutlineColor,
                Thickness = 1,
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
                Parent = prev,
            })

            local colorApi = {
                Value = col,
                SetValueRGB = function(_, c) col = c; prev.BackgroundColor3 = c end,
                SetVisible = function(_, v) prev.Visible = v end,
            }
            Library.Options[idx2] = colorApi
            return colorApi
        end

        Library.Toggles[idx] = toggleApi
        return toggleApi
    end

    -- SLIDER
    function groupbox:AddSlider(idx, config)
        config = config or {}
        local min = config.Min or 0
        local max = config.Max or 100
        local val = config.Default or min
        local suffix = config.Suffix or ""

        local row = Library:Create("Frame", {
            BackgroundColor3 = Library.TertiaryColor,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 44),
            LayoutOrder = #holder:GetChildren(),
            ZIndex = 55,
            Parent = holder,
        })
        Library:Create("UICorner", { CornerRadius = UDim.new(0, 5), Parent = row })

        Library:Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -100, 0, 16),
            Position = UDim2.new(0, 10, 0, 6),
            Font = Library.Font,
            TextSize = 12,
            TextColor3 = Library.FontColor,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = config.Text or idx,
            ZIndex = 56,
            Parent = row,
        })

        local valLabel = Library:Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 90, 0, 16),
            Position = UDim2.new(1, -100, 0, 6),
            Font = Library.Font,
            TextSize = 11,
            TextColor3 = Library.AccentColor,
            TextXAlignment = Enum.TextXAlignment.Right,
            Text = tostring(val) .. suffix,
            ZIndex = 56,
            Parent = row,
        })

        local bar = Library:Create("Frame", {
            BackgroundColor3 = Library.BackgroundColor,
            BorderSizePixel = 0,
            Size = UDim2.new(1, -20, 0, 6),
            Position = UDim2.new(0, 10, 0, 28),
            ZIndex = 56,
            Parent = row,
        })
        Library:Create("UICorner", { CornerRadius = UDim.new(0, 3), Parent = bar })

        local fill = Library:Create("Frame", {
            BackgroundColor3 = Library.AccentColor,
            BorderSizePixel = 0,
            Size = UDim2.new((val - min) / (max - min), 0, 1, 0),
            ZIndex = 57,
            Parent = bar,
        })
        Library:Create("UICorner", { CornerRadius = UDim.new(0, 3), Parent = fill })

        local dragging = false

        local function setVal(v, silent)
            v = math.clamp(tonumber(v) or val, min, max)
            if config.Rounding then
                local mult = 10 ^ config.Rounding
                v = math.floor(v * mult + 0.5) / mult
            else
                v = math.floor(v + 0.5)
            end
            val = v
            fill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0)
            valLabel.Text = tostring(val) .. suffix
            if not silent then
                Library:SafeCallback(config.Callback, val)
            end
        end

        bar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                local rel = (input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
                setVal(min + rel * (max - min))
            end
        end)

        local sliderApi = {
            Value = val,
            SetValue = function(_, v) setVal(v) end,
            SetVisible = function(_, v) row.Visible = v end,
        }
        Library.Options[idx] = sliderApi
        return sliderApi
    end

