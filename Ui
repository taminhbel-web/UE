    function tabbox:AddTab(name)
        local btn = Library:Create("TextButton", {
            BackgroundColor3 = Library.TertiaryColor,
            BorderSizePixel = 0,
            Size = UDim2.new(0, 80, 1, 0),
            Font = Library.Font,
            TextSize = 12,
            TextColor3 = Library.SubTextColor,
            Text = name,
            AutoButtonColor = false,
            ZIndex = 55,
            Parent = btnRow,
        })
        Library:Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = btn })

        local page = Library:Create("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -12, 0, 0),
            Position = UDim2.new(0, 6, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Visible = false,
            ZIndex = 55,
            Parent = pages,
        })
        Library:Create("UIListLayout", {
            Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = page,
        })

        local tab = {
            Button = btn,
            Page = page,
            Holder = holder,
        }

        btn.MouseButton1Click:Connect(function()
            for _, x in pairs(tabbox.Tabs) do
                x.Page.Visible = false
                x.Button.BackgroundColor3 = Library.TertiaryColor
                x.Button.TextColor3 = Library.SubTextColor
            end
            page.Visible = true
            btn.BackgroundColor3 = Library.BackgroundColor
            btn.TextColor3 = Library.FontColor
        end)

        if not next(tabbox.Tabs) then
            page.Visible = true
            btn.BackgroundColor3 = Library.BackgroundColor
            btn.TextColor3 = Library.FontColor
        end

        tabbox.Tabs[name] = tab

        function tab:AddLeftGroupbox(n)
            return Library:MakeGroupbox(self.Page, n, false)
        end

        function tab:AddRightGroupbox(n)
            return Library:MakeGroupbox(self.Page, n, true)
        end

        return tab
    end

    function tabbox:ContainerSize()
        holder.Size = UDim2.new(0.5, -4, 0, 30 + pages.AbsoluteSize.Y + 8)
    end

    return tabbox
end

