-- DEPENDENCY BOX
--------------------------------------------------------------------
function Library:CreateDependencyBox(parent)
    local depbox = {
        Dependencies = {},
        Enabled = true,
    }

    local holder = Library:Create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Visible = false,
        LayoutOrder = #parent:GetChildren(),
        ZIndex = 55,
        Parent = parent,
    })
    Library:Create("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = holder,
    })

    function depbox:AddDependency(option, value)
        table.insert(self.Dependencies, { Option = option, Value = value })
    end

    function depbox:Update()
        local visible = true
        for _, dep in ipairs(self.Dependencies) do
            local opt = dep.Option
            if not opt or opt.Value ~= dep.Value then
                visible = false
                break
            end
        end
        holder.Visible = visible
    end

    function depbox:SetVisible(v)
        holder.Visible = v
    end

    table.insert(Library.DependencyBoxes, depbox)
    return depbox
end

