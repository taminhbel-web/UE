        local function activate()
            for _, t in pairs(window.Tabs) do
                t.Page.Visible = false
                t.Button.BackgroundColor3 = Library.BackgroundColor
                t.Button.TextColor3 = Library.SubTextColor
            end
            page.Visible = true
            tabButton.BackgroundColor3 = Library.TertiaryColor
            tabButton.TextColor3 = Library.FontColor
            window.ActiveTab = tab
        end

        tabButton.MouseEnter:Connect(function()
            if window.ActiveTab ~= tab then
                tabButton.BackgroundColor3 = Library.ElementHover
            end
        end)
        tabButton.MouseLeave:Connect(function()
            if window.ActiveTab ~= tab then
                tabButton.BackgroundColor3 = Library.BackgroundColor
            end
        end)
        tabButton.MouseButton1Click:Connect(activate)

        window.Tabs[name] = tab
        if not window.ActiveTab then activate() end

        function tab:AddLeftGroupbox(groupName)
            return Library:MakeGroupbox(self.Page, groupName, false)
        end

        function tab:AddRightGroupbox(groupName)
            return Library:MakeGroupbox(self.Page, groupName, true)
        end

